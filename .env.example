# Copy to .env.local for local development. Never commit .env.local.
#
# Local values come from `npx supabase status` after `npx supabase start`.
# Hosted values are set in Vercel (Production -> production project,
# Preview -> staging project), not in this repo.

# Supabase API URL (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable (anon) key. Safe for the browser: row-level security protects the data.
# Local: the "Publishable" key printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# There is deliberately no service-role / secret key here. The web app never uses it.
